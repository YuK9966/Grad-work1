<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "ゆびさきnotes" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="flex flex-col min-h-screen text-xs ">
    <!-- ヘッダー -->
    <%= render "shared/header" %>

    <!-- メインコンテンツ -->
    <main class="pt-14 place-items-center <%= content_for?(:main_bg_class) ? yield(:main_bg_class) : 'bg-white' %>">
      <!-- フラッシュメッセージ -->
        <%= render "layouts/flash" %>
      <div class="flex-1 mb-10 overflow-auto justify-center text-gray-600 px-6 sm:px-6 lg:px-0">
        <%= yield %>
      </div>
    </main>

    <!-- フッター -->
    <%= render "shared/footer" %>
  </body>
</html>
