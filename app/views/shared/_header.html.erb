<header class="bg-primary text-white fixed top-0 w-full px-4 z-50">
  <div class="max-w-7xl mx-auto px-1 py-1 flex justify-between items-center">
      <!-- ロゴ -->
    <div class="flex-shrink-0">
      <%= link_to root_path do %>
        <%= image_tag "applogo.jpeg", alt: "ゆびさきnotes", class: "h-12" %>
      <% end %>
    </div>

      <!-- ナビゲーション -->
    <nav class="space-x-2">
      <% if user_signed_in? %>
      <!-- ログイン中のユーザーメニュー -->
      <div class="dropdown dropdown-end"> 
      <!-- ハンバーガーメニュー開始 -->
      <label tabindex="0" class="btn btn-primary mx-1 swap swap-rotate">
        <input type="checkbox" />
          <!-- ハンバーガー -->
            <%= heroicon "bars-3-bottom-right",options: { class: "swap-off fill-current", width:"25", height: "25" } %>
          <!-- open状態 -->
            <%= heroicon "x-mark", options: { class: "swap-on fill-current", width: "25", height: "25" } %>
      </label>
            <ul tabindex="0" class="dropdown-content menu menu-sm p-1 shadow bg-base-100 rounded-box w-40 text-sm text-gray-700 space-y-2">
              <li><%= link_to "マイページ", mypage_path, class: "hover:opacity-80" %></li>
              <li>
                <button>Nail Logs</button>
                <ul class="px-4">
                  <li><%= link_to "新規投稿", new_naillog_path, class: "hover:opacity-80" %></li>
                  <li><%= link_to "投稿一覧", naillogs_path, class: "hover:opacity-80" %></li>
                </ul>
              </li>
              <li>
                <button>Nail Items</button>
                <ul class="px-4">
                  <li><%= link_to "アイテム登録", new_nail_item_path, class: "hover:opacity-80" %></li>
                  <li><%= link_to "アイテム一覧", nail_items_path, class: "hover:opacity-80" %></li>
                </ul>
              <li><%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, class: "hover:opacity-80" %></li>
            </ul>
      </div>
      <!-- 未ログインユーザーメニュー -->
      <% else %>
        <%= link_to "ログイン", new_user_session_path, class: "hover:opacity-80" %>
        <%= link_to "ユーザー登録", new_user_registration_path, class: "hover:opacity-80" %>
      <% end %>
    </nav>
  </div>
</header>