<header class="bg-[#90D1E0] text-white fixed top-0 w-full">
  <div class="max-w-7xl mx-auto px-1 py-1 flex justify-between items-center">
      <!-- ロゴ -->
    <div class="flex-shrink-0">
      <%= link_to root_path do %>
        <%= image_tag "applogo.jpeg", alt: "ゆびさきnotes", class: "h-12" %>
      <% end %>
    </div>
      <!-- ナビゲーション -->
    <nav class="space-x-2 m-r-4">
      <% if user_signed_in? %>
        <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, class: "hover:opacity-80" %>
        <%= link_to "マイページ", root_path, class: "hover:opacity-80" %>
      <% else %>
        <%= link_to "ログイン", new_user_session_path, class: "hover:opacity-80" %>
        <%= link_to "ユーザー登録", new_user_registration_path, class: "hover:opacity-80" %>
      <% end %>
    </nav>
  </div>
</header>