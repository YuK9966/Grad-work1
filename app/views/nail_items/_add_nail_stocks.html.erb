<%= link_to nail_stocks_path(nail_item_id: item_sku),
        id: "nail-stock-button-for-nail-item-#{item_sku.id}",
        data: { turbo_method: :post } do %>
  <label class="items-center">
    <input
      type="checkbox"
      class="toggle toggle-sm border-primary bg-white text-secondary checked:border-primary checked:bg-primary checked:text-white h-3 w-5"
    />
  </label>
<% end %>