<%= form_with model: nail_item do |f| %>
  <div class="field" data-controller="autocomplete" data-autocomplete-url-value="<%= brands_search_nail_items_path %>" role="combobox">
    <%= f.label :brand_name, 'ブランド名' %><br />
    <%= f.text_field :brand_name, autofocus: true, data: { autocomplete_target: 'input' }, class: "w-full mb-3 p-0 px-2 border border-gray-300 bg-white rounded" %>
    <ul data-autocomplete-target="results"></ul> 
    </div>

  <div class="field" data-controller="autocomplete" data-autocomplete-url-value="<%= products_search_nail_items_path %>" role="combobox">
    <%= f.label :product_name, '商品名' %><br />
    <%= f.text_field :product_name, data: { autocomplete_target: 'input' }, class: "w-full mb-3 p-0 px-2 border border-gray-300 bg-white rounded" %>
    <ul data-autocomplete-target="results"></ul> 
    </div>

  <div class="field" data-controller="autocomplete" data-autocomplete-url-value="<%= prod_colors_search_nail_items_path %>" role="combobox">
    <%= f.label :prod_color_name, '色名または色番号' %><br />
    <%= f.text_field :prod_color_name, data: { autocomplete_target: 'input' }, class: "w-full mb-3 p-0 px-2 border border-gray-300 bg-white rounded" %>
    <ul data-autocomplete-target="results"></ul> 
    </div>

  <div class="text-center mt-3 leading-loose">
    <button class="actions h-8 overflow-hidden rounded bg-[#90D1E0] px-4 font-bold text-white transition-all duration-300 hover:bg-[#90D1E0] hover:ring-2 hover:ring-neutral-800 hover:ring-offset-2 text-center">
      <%= f.submit  "登録" %>
    </button>
  </div>
<% end %>
