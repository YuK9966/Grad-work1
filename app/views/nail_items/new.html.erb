<div class="mx-auto mt-6 mb-10 p-4 max-w-sm min-w-70 bg-secondary rounded-lg shadow-md leading-loose">
    <h2 class="text-2xl font-bold mb-4 text-center">Nail Item 登録</h2>
    
      <% if @nail_item.errors.present? %>
        <ul class="ml-4 mb-2">
          <% @nail_item.errors.full_messages.each do |message| %>
            <li class="list-disc text-red-600"><%= message %></li>
          <% end %>
        </ul>
      <% end %>
    <%= render "form", nail_item: @nail_item %>
</div>
