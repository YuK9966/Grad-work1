<% @products.each do |product| %>
	<li class="w-full mb-3 p-0 px-2 border border-gray-300 bg-white rounded hover:bg-blue-200 focus:ring-2 focus:ring-blue-500 dark:text-gray-400 dark:hover:bg-blue-200 dark:hover:text-gray-300" role="option" data-autocomplete-value="<%= product.id %>" data-autocomplete-label="<%= product.name %>">
		<%= product.name %>
	</li>
<% end %>