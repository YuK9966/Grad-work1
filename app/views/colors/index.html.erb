<% content_for :main_bg_class, "bg-base-300" %>
  <div class="container mx-auto max-w-sm mx-6 mt-6 px-8 py-6 rounded-lg shadow-md bg-white">

  <h2 class="text-lg font-bold mb-3 text-center">Next Color is...?</h2>

  <!-- 色表示部分 -->
  <div class="content-center mb-5 text-center">
    <h2 class="text-lg font-bold mb-2" style="color: <%= @text_color %>;">
      <%= @color.name %>
    </h2>
    
    <div class="w-30 h-30 mx-auto flex justify-center border-2 border-[#2E2E2E] item-center" style="background-color: <%= @sq_color %>;">
    </div>
      <br>
    <button class="btn btn-outline mb-3 text-xs ">
      <%= link_to "別の色で再表示", colors_index_path %>
    </button>
    <br><br>
    <%= link_to "この色のデザインを探しに行く", "https://jp.pinterest.com/search/pins/?q=%E3%83%8D%E3%82%A4%E3%83%AB%20#{@color.name}", 
    class: "font-bold text-primary" ,
    target: "_blank", rel: "noopener noreferrer",
    data: {
      controller: "confirm",
      action: "click->confirm#ask",
    } %>
  <br>
  （外部サイトに遷移します）

  <div>
</div>
