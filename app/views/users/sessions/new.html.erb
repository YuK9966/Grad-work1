<div class="max-w-sm min-w-70 mx-6 mt-6 mb-10 p-4 bg-secondary rounded-lg shadow-md leading-loose">
  <h2 class="text-2xl font-bold mb-6 text-center"><%= t('devise.sessions.new.sign_in') %></h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="field">
    <%= f.label :email %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full mb-3 p-0 px-2 border border-gray-300 bg-white rounded" %>
  </div>

  <div class="field">
    <%= f.label :password %><br />
    <%= f.password_field :password, autocomplete: "current-password", class: "w-full mb-3 p-0 px-2 border border-gray-300 bg-white rounded" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="field">
      <%= f.check_box :remember_me %>
      <%= f.label :remember_me %>
    </div>
  <% end %>

  <div class="text-center mt-3 leading-loose">
    <button class="actions h-8 overflow-hidden rounded bg-[#90D1E0] px-4 font-bold text-white transition-all duration-300 hover:bg-[#90D1E0] hover:ring-2 hover:ring-neutral-800 hover:ring-offset-2 text-center">
      <%= f.submit  t('devise.sessions.new.sign_in') %>
    </button>
  </div>
<% end %>


  <!-- ライン -->
  <hr class="my-6 border-gray-300">

  <!-- ログインリンク -->
  <p class="text-center text-gray-600">
    ユーザー登録がまだの方はこちらから</br>
    <%= link_to t('devise.registrations.new.sign_up'), new_user_registration_path, class: "text-blue-500 hover:underline" %>
  </p>
</div>

