<div class="mx-auto mx-6 mt-6 mb-10 p-4 max-w-sm min-w-70 bg-secondary rounded-lg shadow-md leading-loose">
  <h2 class="text-2xl font-bold mb-6 text-center"><%= t('devise.registrations.edit.edit_your_account') %></h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "users/shared/error_messages", resource: resource %>

    <!-- ユーザーネーム -->
    <div class="field">
      <div class="flex items-center gap-1">
        <%= f.label :nickname, class: "inline-block"%><span class="text-red-500">*</span><br />
      </div>
        <%= f.text_field :nickname, autocomplete: "ユーザーネーム", class: "mb-2 px-2 border bg-white border-gray-300 rounded w-full inline-block" %>
    </div>

    <!-- メールアドレス -->
    <div class="field">
      <div class="flex items-center gap-1">
        <%= f.label :email, class: "inline-block"%><span class="text-red-500">*</span><br />
      </div>
        <%= f.email_field :email, autocomplete: "email", class: "mb-2 px-2 border bg-white border-gray-300 rounded w-full" %>
    </div>

    <!-- 性別 -->
    <div>
      <%= f.label :gender, "性別", class: "block" %>
      <%= f.select :gender, ["女性", "男性", "その他"], { prompt: "選択してください" }, class: "mb-2 px-2 py-1 border bg-white border-gray-300 rounded" %>
    </div>

    <!-- 年代 -->
    <div>
      <%= f.label :age_group, "年代", class: "block text-xs" %>
      <%= f.select :age_group, [["10代", "10"], ["20代", "20"], ["30代", "30"], ["40代", "40"], ["50代", "50"], ["60代以上", "60"]], { prompt: "選択してください" }, class: "mb-2 px-2 py-1 border bg-white border-gray-300 rounded" %>
    </div>

    <!-- ネイルを始めた時期 -->
    <div>
      <%= f.label :started_nail_on, "セルフネイルを始めた時期", class: "block text-xs" %>
      <div class="flex gap-2 mb-3">
        <%= text_field_tag :started_nail_year,
              resource.started_nail_on&.year,
              class: "w-20 px-2 border bg-white border-gray-300 rounded" %>
        <span>年</span>
        <%= text_field_tag :started_nail_month,
              resource.started_nail_on&.month,
              class: "w-16 px-2 border bg-white border-gray-300 rounded" %>
        <span>月</span>
      </div>
    </div>


    <!-- 現在のパスワード -->
    <div class="field">
      <div class="flex items-center gap-1">
        <%= f.label :current_password, class: "inline-block"%><span class="text-red-500">*</span><br />
      </div>
        <div class="text-[0.6rem] mb-0">※<%= t('devise.registrations.edit.we_need_your_current_password_to_confirm_your_changes') %>
        </div>
      <%= f.password_field :current_password, autocomplete: "current-password", class: "mb-3 px-3 border bg-white border-gray-300 rounded w-full" %>
    </div>
    <br>
    
    <!-- 新しいパスワード -->
    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <div class="mb-3 px-3 border bg-white border-gray-300 rounded w-full">
      <%= t('.currently_waiting_confirmation_for_email', email: resource.unconfirmed_email) %></div>
    <% end %>

    <div class="field leading-snug">
      <div class="flex items-center gap-1">
        <%= f.label :password, "新しいパスワード", class: "block" %><span class="text-[0.6rem]">（<%= @minimum_password_length %>文字以上）</span>
        </div>
        <div class="text-[0.6rem] inline-block">※<%= t('devise.registrations.edit.leave_blank_if_you_don_t_want_to_change_it') %></div><br />
        <%= f.password_field :password, autocomplete: "new-password", class: "mb-3 px-3 border bg-white border-gray-300 rounded w-full leading-loose" %>
    </div>

    <!-- パスワード確認用 -->
    <div class="field">
      <%= f.label :password_confirmation, "新しいパスワード(確認用)" %><br>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mb-3 px-3 border bg-white border-gray-300 rounded w-full"  %>
    </div>

    <div class="actions text-center mt-2">
      <%= f.submit t('devise.registrations.edit.update'), class: "btn btn-primary px-2 w-15 mx-0 font-bold text-xs text-center" %>
    </div>
  <% end %>

  <!-- ライン -->
  <hr class="my-6 border-gray-300">

  <!-- アカウント削除リンク -->
  <div class="text-center text-[0.6rem]"">
    <%= button_to t('devise.registrations.edit.cancel_my_account'),
      registration_path(resource_name),
      data: { confirm: t('devise.registrations.edit.are_you_sure'),
      turbo_confirm: t('.are_you_sure') }, method: :delete %>
  </div>

</div>