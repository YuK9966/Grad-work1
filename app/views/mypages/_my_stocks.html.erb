<h2 class="text-lg font-bold mb-3 text-center">My Nail Stocks</h2>

  <div class="mb-3">
    <% if @item_sku.empty? %>
      <p class="text-center text-xs text-gray-600">My Nail Stocksにアイテムが登録されていません</p>
    <% else %>
      <ul class="list-unstyled">
        <%= render partial: "stock_sku", collection: @item_sku %>
      </ul>
    <% end %>
    <div class="text-center mt-4">
      <%= link_to "アイテムリストから登録する", nail_items_path,
      class: "btn btn-primary p-2 text-xs" %>
    </div>
  </div>