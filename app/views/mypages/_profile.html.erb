<h2 class="text-lg font-bold mb-3 text-center">ユーザー情報</h2>
  <div class="flex items-right justify-end px-4">  
    <%= link_to edit_user_registration_path do %>
      <%= heroicon "pencil", options: {class: "items-right", width: "15", height: "15" } %>
    <% end %>
  </div>

<div class="flex-auto mr-2 ml-5">
    <!-- ユーザー名 -->
    <p class="text-xs font-semibold text-gray-800 text-left">
      ユーザー名
    </p>
    <p class="text-xs text-gray-800 mjjb-1 text-left pl-2">
      <%= @user.nickname %>
    </p>

    <!-- 年代 -->
    <p class="text-xs font-semibold text-gray-800 text-left">
      年代
    </p>
    <p class="text-xs text-gray-800 mb-1 text-left pl-2">
      <%= @user.age_group %>
    </p>

    <!-- 性別 -->
    <p class="text-xs font-semibold text-gray-800 text-left">
      性別
    </p>
    <p class="text-xs text-gray-800 mb-1 text-left pl-2">
      <%= @user.gender %>
    </p>

    <!-- 性別 -->
    <p class="text-xs font-semibold text-gray-800 text-left">
      セルフネイルを始めた時期
    </p>
    <p class="text-xs text-gray-800 mb-1 text-left pl-2">
      <%= @user.started_nail_on %>
    </p>
</div> 