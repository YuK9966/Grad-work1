    <div class="field mb-3">
      <div class="flex items-center gap-1">
        <%= f.label :title, "タイトル", class: "inline-block" %><span class="text-red-500"> *</span><br />
      </div>
        <%= f.text_field :title, class: "input w-full" %>
    </div>

    <div class="field mb-3">
      <%= f.label :nailed_date, "塗った日" %><br />
      <%= f.date_field :nailed_date, class: "input input-bordered w-40" %>
    </div>

    <div class="field mb-3">
      <%= f.label :main_image, "メイン画像", class: "text-xs"%><br />
      <%= f.file_field :main_image, class: "file-input file-input-primary text-xs file:text-xs file:px-2" %>
      <%= f.hidden_field :picture_cache %>
    </div>

    <div class="field mb-3">
      <%= f.label :design_url, "参考デザイン(URL)" %><br />
      <%= f.url_field :design_url, placeholder: "https://", class: "input w-full" %>
    </div>

    <div class="field mb-3">
      <%= f.label :nail_shape, "爪の形" %><br />
      <%= f.select :nail_shape, 
        options_for_select(["ラウンド", "オーバル", "スクエア", "スクエアオフ", "アーモンド", "バレリーナ", "その他"],
        @naillog.nail_shape), { prompt: '選択してください' }, class: "select w-40" %>
    </div>

    <div class="field">
      <div id="log-nails-container"
          data-controller="log-nails"
          data-log-nails-options-value="<%= escape_once options_for_select(@nail_items.map { |item| [ "#{item.brand.name} / #{item.product.name} / #{item.prod_color.name}", item.id ] }) %>">

        <%= f.label :nail_item_id, "使用したアイテム" %>
        <%= f.fields_for :log_nails do |lf| %>
          <%= render "nail_items_fields", f: lf, nail_items: @nail_items %>
        <% end %>
        <div data-log-nails-target="rows"></div>
        <button type="button"
            data-action="log-nails#add"
            class="btn btn-primary mb-3 text-xs px-2">
        ＋ アイテム追加
        </button>
      </div>
    </div>

    <div class="field mb-3">
      <%= f.label :body, "コメント" %><br />
      <%= f.text_area :body, class: "textarea textarea-bordered w-full", rows: 3 %>
    </div>
