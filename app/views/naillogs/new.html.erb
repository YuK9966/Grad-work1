<div class="container mx-auto max-w-sm mx-6 mt-6 mb-10 p-6 rounded-lg shadow-md leading-loose bg-base-300">
  <h2 class="text-2xl font-bold mb-4 text-center">New Nail Log</h2>
    <% if @naillog.errors.present? %>
      <ul class="ml-4 mb-2">
        <% @naillog.errors.full_messages.each do |message| %>
          <li class="list-disc text-red-600"><%= message %></li>
        <% end %>
      </ul>
    <% end %>
    <div class="form-control mb-4">
      <%= form_with model: @naillog do |f| %>
        <%= render "form",  f: f, nail_items: @nail_items %>

          <div class="text-center mt-3 leading-loose flex justify-center gap-4">
            <!-- 下書き保存ボタン -->
            <%= f.submit "下書き保存", name: "commit", value: "下書き", class: "btn px-4 w-20 font-bold text-primary text-sm transition-all duration-300 text-center" %>
            <!-- 投稿ボタン -->
            <%= f.submit "投稿", class: "btn btn-primary px-4 w-20 font-bold text-sm text-center" %>
          </div>
      <% end %>
    </div>
</div>