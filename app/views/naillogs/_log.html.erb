<div class="bg-white p-2 m-2 flex justify-between items-start">

<!-- テキスト側要素 -->
  <div class="flex-auto mr-2 ml-2">
    <!-- タイトル -->
    <h2 class="text-sm font-semibold text-gray-800 mb-1 text-left">
      <%= log.title %>
    </h2>

    <!-- ユーザー名 -->
    <p class="text-gray-600 text-xs text-right object-bottom">
      <%= log.user.nickname %>
      <br>

    <!-- 投稿日 -->
      投稿日：<%= log.created_at.strftime("%Y-%m-%d") %>
    </p>
  </div>

  <!-- 画像側要素 -->
  <div class="w-18 h-18 bg-gray-200 rounded-md overflow-hidden flex-shrink-0">
    <% if log.main_image.present? %>
      <%= image_tag log.main_image.url, class: "w-18 h-18 object-cover" %>
    <% else %>
      <!-- 画像がない場合の仮表示 -->
      <div class="w-18 h-18 bg-gray-100 flex items-center justify-center text-gray-400 text-xs">
        no image
      </div>
    <% end %>
  </div>
</div>
