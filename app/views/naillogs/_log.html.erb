<div class="bg-white p-2 m-2 flex justify-between items-start">

<!-- テキスト側要素 -->
  <div class="flex-1 mr-4">
    <!-- タイトル -->
    <h2 class="text-sm font-semibold text-gray-800 mb-1">
      <%= log.title %>
    </h2>

    <!-- ユーザー名 -->
    <p class="text-gray-600 text-sm text-right">
      <%= log.user.nickname %>
    </p>

    <!-- 投稿日 -->
    <p class="text-gray-500 text-sm text-right">
      投稿日：<%= log.created_at.strftime("%Y-%m-%d") %>
    </p>
  </div>

  <!-- 画像側要素 -->
  <div class="w-18 h-18 bg-gray-200 rounded-md overflow-hidden flex-shrink-0">
    <% if log.image_url.present? %>
      <%= image_tag log.image_url, class: "w-18 h-18 object-cover" %>
    <% else %>
      <!-- 画像がない場合の仮表示 -->
      <div class="w-18 h-18 bg-gray-100 flex items-center justify-center text-gray-400 text-xs">
        no image
      </div>
    <% end %>
  </div>
</div>
