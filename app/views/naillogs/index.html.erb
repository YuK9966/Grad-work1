<div class="mx-auto p-4 max-w-sm min-w-70 rounded-lg bg-secondary leading-loose shadow-md">
    <h2 class="text-lg font-bold mb-3 text-center">Nail Logs</h2>

    <div class="mb-5 text-center">
          <ul class="list-unstyled">
            <%= render partial: "log", collection: @naillogs %>
          </ul>
    </div>

    <!-- Pagination -->
    <div class="text-center flex self-center join justify-center">
      <%= paginate @naillogs %>
    </div>
</div>