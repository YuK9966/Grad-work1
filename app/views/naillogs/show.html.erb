<% content_for :main_bg_class, "bg-base-300" %>
  <div class="container mx-auto mt-6 mb-10 px-8 py-6 max-w-sm min-w-70 rounded-lg shadow-md leading-loose bg-white">

    <!-- 下書きバッジ -->
    <% if @naillog.draft? %>
      <span class="badge badge-outline badge-primary text-[0.6rem] mb-1 ml-4 px-3">下書き</span>
    <% end %>

  <!-- タイトル等 -->
  <div class="flex justify-between items-center leading-tight mb-1">
    <!-- タイトル -->
      <h2 class="card-title pl-4">
        <%= @naillog.title %>
      </h2>

    <!-- 編集・削除ボタン -->
      <% if current_user&.own?(@naillog) %>
        <div class="flex justify-end text-primary gap-2 pl-1 pr-4">
          <%= link_to edit_naillog_path(@naillog), id: "button-edit-#{@naillog.id}" do %>
            <%= heroicon "pencil", options: {class: "items-right", width: "15", height: "15" } %>
          <% end %>
          <%= link_to @naillog,
                id: "button-delete-#{@naillog.id}",
                data: { turbo_method: :delete, turbo_confirm: t('defaults.delete_confirm') } do %>
            <%= heroicon "trash", options: {class: "items-right", width: "15", height: "15" } %>
          <% end %>
        </div>
      <% end %>
  </div>

    <!-- ユーザー名 -->
    <div class="items-center text-right leading-4 mb-4 px-4">
      <%= @naillog.user.nickname %>
      <br>
      <!-- 塗った日 -->
      塗った日：<%= @naillog.nailed_date %>
      <br>
    <!-- 投稿日 -->
      投稿日：<%= @naillog.created_at.strftime("%Y-%m-%d") %>
    </div>

  <!-- 画像側要素 -->
    <figure class="items-center place-items-center mb-4 px-1">
      <% if @naillog.main_image.present? %>
        <%= image_tag @naillog.main_image.url, class: "w-80 h-80 object-cover" %>
      <% else %>
        <!-- 画像がない場合の仮表示 -->
        <div class="w-70 h-70 bg-gray-100 flex items-center justify-center text-gray-400 text-base">
          no image
        </div>
      <% end %>
    </figure>

    <!-- 詳細要素 -->
      <div class="items-left text-left mb-1 px-6">
    <!-- タグ等 -->
    <!-- 爪の形 -->
        #<%= @naillog.nail_shape %>
      </div>

    <!-- 使用アイテム -->
    <% if !@use_items.empty? %>
      <div class="items-left text-left mb-1">
        <b>使用アイテム</b>
      </div>

      <div class="mb-2">
        <ul class="list-unstyled">
          <%= render partial: "naillogs/use_items", collection: @use_items %>
        </ul>
      </div>
    <% end %>

    <!-- body -->
    <div class="text-left items-left my-5 px-6 text-sm">
      <%= @naillog.body %>
    </div>

  </div>

